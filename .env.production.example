# Production settings. Copy to `.env` (cp .env.production.example .env), fill in, and never commit the result.
# Every value is explained in DEPLOYMENT.md. Keep comments on their own lines (a comment after a value becomes part of the value).

# ---- Required ----
# The address people will visit. Its DNS A record must point at this server.
SITE_DOMAIN=assistant.example.com
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=you@example.com
# Your provider key. It stays on the server.
OPENROUTER_API_KEY=
# These e-mails become administrators when they sign up (comma-separated).
ADMIN_EMAILS=you@example.com

# ---- Your site's name and legal details (shown on the Terms and Privacy pages) ----
SITE_NAME=Multi-Mode Assistant
# Your name or company.
OPERATOR_NAME=
CONTACT_EMAIL=you@example.com
# Set to 1 only after a lawyer has reviewed /terms and /privacy. Until then they show a template notice.
LEGAL_REVIEWED=0

# ---- Who may sign up ----
# 0 closes registration (existing users can still sign in).
ALLOW_SIGNUP=1
# When set, new users must enter this code.
INVITE_CODE=

# ---- Spending limits in USD. These protect your provider account ----
# Each user's allowance per calendar month (admins can change it per user).
DEFAULT_USER_MONTHLY_USD=2
# The most one question may cost, whatever the browser asks for.
MAX_RUN_USD=0.5
# All users together. When reached, paid features stop for everyone until next month. 0 = no cap.
GLOBAL_MONTHLY_USD=50

# ---- Load limits (one server, one process) ----
# Questions running at the same moment, all users together.
MAX_CONCURRENT_RUNS=8
MAX_RUNS_PER_USER=2
RUNS_PER_MINUTE=20
# Uploaded files per user.
MAX_USER_STORAGE_MB=500
# Largest chat archive a user may import.
MAX_IMPORT_MB=50

# ---- Password-reset e-mail (optional; without it an admin resets passwords from the command line) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Multi-Mode Assistant <no-reply@example.com>

# ---- Optional ----
# A small helper model screens each message for safety before the user's selected model answers. 0 switches it off.
INPUT_CHECK=1
NVIDIA_API_KEY=
SESSION_DAYS=30
