# Server-side credentials. Copy this file to .env and supply your own values.
# Never add these keys to frontend NEXT_PUBLIC_* variables.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Set NVIDIA's actual account rates before enabling its hosted models.
# NVIDIA_INPUT_USD_PER_MILLION=
# NVIDIA_OUTPUT_USD_PER_MILLION=

# Browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Checked answers are released to the frontend after validation.
CHECK_ANSWERS=1
STREAM_BEFORE_CHECK=0

# The model you select always writes the answer. A small helper model only screens each message for safety first.
# INPUT_CHECK=0 skips that helper call (the built-in deny-list still applies).
# INPUT_CHECK=1

# Accounts. On by default: visitors sign up and every account's data is private.
# AUTH_REQUIRED=0 switches to the old open single-user mode (local use only; refused when APP_ENV=production).
# AUTH_REQUIRED=0
# E-mails that become administrators when they sign up (comma-separated).
# ADMIN_EMAILS=you@example.com

# Going public? Use .env.production.example and read DEPLOYMENT.md.
