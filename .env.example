# Server-side credentials. Copy this file to .env and supply your own values.
# Never add these keys to frontend NEXT_PUBLIC_* variables.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Set NVIDIA's actual account rates before enabling its hosted models.
# NVIDIA_INPUT_USD_PER_MILLION=
# NVIDIA_OUTPUT_USD_PER_MILLION=

# Browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Checked answers are released to the frontend after validation.
CHECK_ANSWERS=1
STREAM_BEFORE_CHECK=0
